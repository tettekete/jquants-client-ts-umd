{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "Build for debug",
			"command": "npm",
			"args": ["run", "debug:build"],
			"options": {
			  "cwd": "${workspaceFolder}"
			},
			"problemMatcher": ["$tsc"],
			"group": "build",
			"detail": "TSC: build for debug using tsconfig.dev.json",
			"presentation": {
			  "reveal": "always",
			  "panel": "new"
			},
			"runOptions": {
			  "runOn": "default"
			}
		}
	]
  }